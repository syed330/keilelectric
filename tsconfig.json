{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noImplicitAny": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true, "lib": ["ES2022", "DOM"], "types": ["node"],
    "allowImportingTsExtensions": false, "noEmit": true
  },
  "include": ["src/**/*.ts", "netlify/functions/**/*.mts"]
}
