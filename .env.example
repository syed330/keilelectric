# Copy these into Netlify › Site configuration › Environment variables (not into a file on the server).
# Supabase › Project Settings › API (or Data API): the project URL and the server-side secret key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # never the anon / publishable key
# Two long random strings, e.g. from: openssl rand -hex 32
SESSION_SECRET=
SYNC_SECRET=
# Optional: USE_VUEXY=1 if you put your licensed Vuexy files in public/vendor/vuexy/
